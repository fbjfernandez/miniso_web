# Copia este archivo a backend/.env y completa los valores
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Usa la clave "service_role" (Project Settings → API). Nunca la pongas en el frontend.
SUPABASE_KEY=
# Cadena larga y aleatoria. Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_HOURS=8
# Orígenes del frontend permitidos, separados por coma
ALLOWED_ORIGINS=http://localhost:3000,https://miniso-web-omega.vercel.app
PORT=3000
